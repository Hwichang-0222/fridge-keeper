<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.fridgekeeper.mapper.CategoryMapper">

    <!-- 모든 카테고리 목록 조회 -->
    <select id="selectAllCategories" resultType="org.fridgekeeper.dto.CategoryDTO">
        <![CDATA[
        SELECT * FROM category
        ]]>
    </select>

    <!-- 카테고리 단건 조회 -->
    <select id="selectCategoryById" parameterType="long" resultType="org.fridgekeeper.dto.CategoryDTO">
        <![CDATA[
        SELECT * FROM category WHERE category_id = #{categoryId}
        ]]>
    </select>

    <!-- 카테고리 추가 -->
    <insert id="insertCategory" parameterType="org.fridgekeeper.dto.CategoryDTO">
        <![CDATA[
        INSERT INTO category (name, color, created_by_user_id)
        VALUES (#{name}, #{color}, #{createdByUserId})
        ]]>
    </insert>

    <!-- 카테고리 정보 수정 -->
    <update id="updateCategory" parameterType="org.fridgekeeper.dto.CategoryDTO">
        <![CDATA[
        UPDATE category SET name = #{name}, color = #{color} WHERE category_id = #{categoryId}
        ]]>
    </update>
	
    <!-- 카테고리 삭제 -->
    <delete id="deleteCategory" parameterType="long">
        <![CDATA[
        DELETE FROM category WHERE category_id = #{categoryId}
        ]]>
    </delete>

</mapper>
