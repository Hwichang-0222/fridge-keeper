<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.fridgekeeper.mapper.ItemMapper">

	<!-- 모든 아이템 목록 조회 -->
	<select id="selectAllItems" resultType="org.fridgekeeper.dto.ItemDTO">
		<![CDATA[
		SELECT * FROM item
		]]>
	</select>

	<!-- 아이템 단건 조회 -->
	<select id="selectItemById" parameterType="long" resultType="org.fridgekeeper.dto.ItemDTO">
		<![CDATA[
		SELECT * FROM item WHERE item_id = #{itemId}
		]]>
	</select>

	<!-- 바코드로 아이템 조회 -->
	<select id="selectItemByBarcode" parameterType="string" resultType="org.fridgekeeper.dto.ItemDTO">
		<![CDATA[
		SELECT * FROM item WHERE barcode = #{barcode}
		]]>
	</select>

	<!-- 아이템 추가 -->
	<insert id="insertItem" parameterType="org.fridgekeeper.dto.ItemDTO">
		<![CDATA[
		INSERT INTO item (fridge_id, category_id, name, expiration_date, memo, created_at, barcode)
		VALUES (#{fridgeId}, #{categoryId}, #{name}, #{expirationDate}, #{memo}, #{createdAt}, #{barcode})
		]]>
	</insert>

	<!-- 아이템 정보 수정 -->
	<update id="updateItem" parameterType="org.fridgekeeper.dto.ItemDTO">
		<![CDATA[
		UPDATE item
		SET fridge_id = #{fridgeId},
			category_id = #{categoryId},
			name = #{name},
			expiration_date = #{expirationDate},
			memo = #{memo},
			created_at = #{createdAt},
			barcode = #{barcode}
		WHERE item_id = #{itemId}
		]]>
	</update>

	<!-- 아이템 바코드만 수정 -->
	<update id="updateItemBarcode">
		<![CDATA[
		UPDATE item SET barcode = #{barcode} WHERE item_id = #{itemId}
		]]>
	</update>

	<!-- 아이템 삭제 -->
	<delete id="deleteItem" parameterType="long">
		<![CDATA[
		DELETE FROM item WHERE item_id = #{itemId}
		]]>
	</delete>

</mapper>
