<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.fridgekeeper.mapper.UserMapper">

    <!-- 모든 사용자 목록 조회 -->
    <select id="selectAllUsers" resultType="org.fridgekeeper.dto.UserDTO">
        <![CDATA[
        SELECT * FROM user
        ]]>
    </select>

    <!-- 사용자 단건 조회 -->
    <select id="selectUserById" parameterType="long" resultType="org.fridgekeeper.dto.UserDTO">
        <![CDATA[
        SELECT * FROM user WHERE user_id = #{userId}
        ]]>
    </select>

    <!-- 사용자 추가 -->
    <insert id="insertUser" parameterType="org.fridgekeeper.dto.UserDTO">
        <![CDATA[
        INSERT INTO user (email, password, nickname, created_at)
        VALUES (#{email}, #{password}, #{nickname}, #{createdAt})
        ]]>
    </insert>

    <!-- 사용자 정보 수정 -->
    <update id="updateUser" parameterType="org.fridgekeeper.dto.UserDTO">
        <![CDATA[
        UPDATE user SET email = #{email}, password = #{password}, nickname = #{nickname} WHERE user_id = #{userId}
        ]]>
    </update>
	
    <!-- 사용자 삭제 -->
    <delete id="deleteUser" parameterType="long">
        <![CDATA[
        DELETE FROM user WHERE user_id = #{userId}
        ]]>
    </delete>

</mapper>
